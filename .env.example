# Postgres (docker-compose default)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/ai_company

# Anthropic API key for chat + agent narrative copy
ANTHROPIC_API_KEY=sk-ant-...

# Optional: real connector credentials. v0 ships with fixture replayers so
# the reviewer doesn't need real accounts to run the demo.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_ACCESS_TOKEN=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
